%% LE3-1.m
% Polygon plot and area computation from vertex coordinates
clc; clear; close all;

%% Input: number of vertices (must be at least 7)
n = input('Enter the number of vertices (at least 7): ');
while n < 7
    n = input('The polygon must have at least 7 vertices. Try again: ');
end

% Preallocate arrays for the coordinates
x = zeros(1, n);
y = zeros(1, n);

% Get the coordinates of each vertex (enter them in order around the shape)
for i = 1:n
    fprintf('Vertex %d\n', i);
    x(i) = input('  x = ');
    y(i) = input('  y = ');
end

%% Part a: Plot the polygon from the contents of the arrays
% Close the polygon by repeating the first vertex at the end
xClosed = [x, x(1)];
yClosed = [y, y(1)];

figure;
fill(x, y, 'c', 'FaceAlpha', 0.3);                % shaded interior
hold on;
plot(xClosed, yClosed, '-b', 'LineWidth', 2);     % edges
plot(x, y, 'ro', 'MarkerFaceColor', 'r');         % vertices

% Label each vertex with its coordinates
for i = 1:n
    text(x(i) + 0.1, y(i) + 0.1, sprintf('(%g, %g)', x(i), y(i)));
end

grid on;
axis equal;
xlabel('x-axis');
ylabel('y-axis');
title(sprintf('Polygon with %d Vertices', n));
hold off;

%% Part b: Compute the area using the formula
% Area = 1/2 * | sum of ( x(i)*y(i+1) - x(i+1)*y(i) ) |
total = 0;
for i = 1:n
    total = total + (xClosed(i)*yClosed(i+1) - xClosed(i+1)*yClosed(i));
end
area = abs(total) / 2;

%% Display the results
fprintf('\nVertices (x, y):\n');
disp([x' y']);
fprintf('Number of vertices = %d\n', n);
fprintf('Area = %.2f square units\n', area);

% Optional check using MATLAB's built-in function
fprintf('Check using polyarea = %.2f square units\n', polyarea(x, y));

%% Save the plot as LE3-1.png
saveas(gcf, 'LE3-1.png');
