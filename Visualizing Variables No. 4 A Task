%% LE4_4.m
% Item 4a: CoViD Cases in the 3 Highly Urbanized Cities of Region 7
% Sept. 19 - Sept. 25, 2021 (3D pie plot)
clc; clear; close all;

%% Load the data from the .mat file
load('HUC-CEB(19Sept-25Sept).mat')   % loads CC, LLC, MC

%% Prepare the data
% Each variable is 7 x 3: rows = days, columns = Cases, Recoveries, Deaths
CC = double(CC);
LLC = double(LLC);
MC = double(MC);

%% Total Cases for the week (sum of the 7 days) for each city
totalCases = [sum(CC(:,1)) sum(LLC(:,1)) sum(MC(:,1))];

%% Labels
cities = {'Cebu City', 'Lapulapu City', 'Mandaue City'};

%% Part a: 3D pie plot of Cases
figure
pie3(totalCases)
colormap(parula(3))
legend(cities, 'Location', 'southoutside', 'Orientation', 'horizontal')
title('Cebu HUCs CoVID Cases (9/19/2021-9/25/2021)')

%% Display the totals
for i = 1:3
    fprintf('%s: %d cases\n', cities{i}, totalCases(i));
end

%% Save the plot
saveas(gcf, 'LE4_4a.png')
