%% LE4_3.m
% Item 3: CoViD Cases, Recoveries and Deaths in the 3 Highly Urbanized
% Cities of Region 7, Sept. 19 - Sept. 25, 2021 (3D bar plots)
clc; clear; close all;

%% Load the data from the .mat file
load('HUC-CEB(19Sept-25Sept).mat')   % loads CC, LLC, MC

%% Prepare the data
% Each variable is 7 x 3: rows = days, columns = Cases, Recoveries, Deaths
CC = double(CC);
LLC = double(LLC);
MC = double(MC);

%% Labels
cities = {'CC', 'LLC', 'MC'};
days = {'9/19', '9/20', '9/21', '9/22', '9/23', '9/24', '9/25'};

dataNames = {'Cases', 'Recoveries', 'Deaths'};     % column 1, 2, 3
fileNames = {'LE4_3a.png', 'LE4_3b.png', 'LE4_3c.png'};

cmap = parula(7);    % one color per date

%% Parts a, b, c: one 3D bar plot for each data type
for col = 1:3
    % Pick the same column from each city (7 days x 3 cities)
    data = [CC(:,col) LLC(:,col) MC(:,col)];

    figure
    h = bar3(data);
    colormap(cmap)

    % Color the bars by date (each row = one day = one color)
    for k = 1:length(h)                       % one surface per city
        nRows = size(h(k).ZData, 1) / 7;      % surface rows used by each bar
        cdata = zeros(size(h(k).ZData));
        for j = 1:7
            cdata((j-1)*nRows+1 : j*nRows, :) = j;
        end
        h(k).CData = cdata;
        h(k).FaceColor = 'flat';
    end

    % Format the plot
    xticks(1:3)
    xticklabels(cities)
    yticks(1:7)
    yticklabels(days)
    xlabel('Cities')
    ylabel('Dates')
    title(['Cebu HUCs CoVID ' dataNames{col} ' (9/19/2021-9/25/2021)'])

    % Legend (one entry per date, using empty patches as stand-ins)
    hold on
    p = gobjects(1, 7);
    for j = 1:7
        p(j) = patch(NaN, NaN, cmap(j,:));
    end
    legend(p, days, 'Location', 'northeastoutside')
    hold off

    % Save the plot
    saveas(gcf, fileNames{col})
end
