%% Polygon from Vertex Coordinates
clc; clear; close all;

% Ask for the number of vertices
n = input('Enter the number of vertices (at least 3): ');
while n < 3
    n = input('A polygon needs at least 3 vertices. Try again: ');
end

% Preallocate arrays for the coordinates
x = zeros(1, n);
y = zeros(1, n);

% Get the coordinates of each vertex
for i = 1:n
    fprintf('Vertex %d\n', i);
    x(i) = input('  x = ');
    y(i) = input('  y = ');
end

% Close the polygon by repeating the first vertex at the end
xClosed = [x, x(1)];
yClosed = [y, y(1)];

% Plot the polygon
figure;
plot(xClosed, yClosed, '-b', 'LineWidth', 2);   % edges
hold on;
plot(x, y, 'ro', 'MarkerFaceColor', 'r');         % vertices
fill(x, y, 'c', 'FaceAlpha', 0.3);                % shaded interior

% Label each vertex with its coordinates
for i = 1:n
    text(x(i) + 0.1, y(i) + 0.1, sprintf('(%g, %g)', x(i), y(i)));
end

% Make the plot look nice
grid on;
axis equal;
xlabel('x-axis');
ylabel('y-axis');
title(sprintf('Polygon with %d Vertices', n));
hold off;

% Compute and display the area (Shoelace formula) and perimeter
area = polyarea(x, y);
perimeter = sum(sqrt(diff(xClosed).^2 + diff(yClosed).^2));

fprintf('\nVertices:\n');
disp([x' y']);
fprintf('Area = %.2f square units\n', area);
fprintf('Perimeter = %.2f units\n', perimeter);
