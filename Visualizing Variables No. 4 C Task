%% LE4_4c.m
% Item 4c: CoViD Deaths in the 3 Highly Urbanized Cities of Region 7
% Sept. 19 - Sept. 25, 2021 (3D pie plot)
clc; clear; close all;

%% Load the data from the .mat file
load('HUC-CEB(19Sept-25Sept).mat')   % loads CC, LLC, MC

%% Prepare the data
% Each variable is 7 x 3: rows = days, columns = Cases, Recoveries, Deaths
CC = double(CC);
LLC = double(LLC);
MC = double(MC);

%% Total Deaths for the week (sum of the 7 days) for each city
totalDeaths = [sum(CC(:,3)) sum(LLC(:,3)) sum(MC(:,3))];

%% Labels
cities = {'Cebu City', 'Lapulapu City', 'Mandaue City'};

%% Part c: 3D pie plot of Deaths
figure
pie3(totalDeaths)
colormap(parula(3))
legend(cities, 'Location', 'southoutside', 'Orientation', 'horizontal')
title('Cebu HUCs CoVID Deaths (9/19/2021-9/25/2021)')

%% Display the totals
for i = 1:3
    fprintf('%s: %d deaths\n', cities{i}, totalDeaths(i));
end

%% Save the plot
saveas(gcf, 'LE4_4c.png')
