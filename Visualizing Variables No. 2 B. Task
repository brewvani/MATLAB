%% LE4_2b.m
% Item 2b: Region 7 weekly COVID-19 Recoveries (bar plot + trend line + average)
clc; clear; close all;

%% Load the data from the .mat file
load('R7-Q3(12weeks).mat')    % loads Cases, Recoveries, Deaths

%% Week labels (dates)
weeks = {'7/1-7/7', '7/8-7/14', '7/15-7/21', '7/22-7/28', ...
    '7/29-8/4', '8/5-8/11', '8/12-8/18', '8/19-8/25', ...
    '8/26-9/1', '9/2-9/8', '9/9-9/15', '9/16-9/22'};

%% Compute the average number of recoveries for the 12 weeks
avgRec = mean(Recoveries);
avgLine = avgRec * ones(1, 12);       % same value for every week

%% Plot
figure
bar(1:12, Recoveries)                           % bar plot of weekly recoveries
hold on
plot(1:12, Recoveries, 'x-', 'LineWidth', 3)    % trend line (x-marker, width 3)
plot(1:12, avgLine, '--g', 'LineWidth', 1)      % average (dashed, green, width 1)

% Label the average line
text(12.5, avgRec, sprintf('%.2f', avgRec), ...
    'Color', 'g', 'HorizontalAlignment', 'right', 'VerticalAlignment', 'bottom')
hold off

%% Format the plot
xticks(1:12)
xticklabels(weeks)
xtickangle(45)
xlabel('Weeks')
ylabel('Count')
title('Region 7 3rd Quarter 2021 CoViD Recoveries')
legend('Weekly Recoveries', 'Weekly Recoveries Trend', 'Average Recoveries', 'Location', 'south')

%% Save the plot
saveas(gcf, 'LE4_2b.png')
