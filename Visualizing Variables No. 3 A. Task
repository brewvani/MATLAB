%% LE4_3.m
% Item 3a: CoViD Cases in the 3 Highly Urbanized Cities of Region 7
% Sept. 19 - Sept. 25, 2021 (3D bar plot)
clc; clear; close all;

%% Load the data from the .mat file
load('HUC-CEB(19Sept-25Sept).mat')   % loads CC, LLC, MC

%% Prepare the data
% Each variable is 7 x 3: rows = days, columns = Cases, Recoveries, Deaths
CC = double(CC);
LLC = double(LLC);
MC = double(MC);

Cases = [CC(:,1) LLC(:,1) MC(:,1)];   % 7 days x 3 cities

%% Labels
cities = {'CC', 'LLC', 'MC'};
days = {'9/19', '9/20', '9/21', '9/22', '9/23', '9/24', '9/25'};

%% Part a: 3D bar plot of Cases
figure
h = bar3(Cases);

% Color the bars by date (each row = one day = one color)
cmap = parula(7);
colormap(cmap)
for k = 1:length(h)                       % one surface per city
    nRows = size(h(k).ZData, 1) / 7;      % surface rows used by each bar
    cdata = zeros(size(h(k).ZData));
    for j = 1:7
        cdata((j-1)*nRows+1 : j*nRows, :) = j;
    end
    h(k).CData = cdata;
    h(k).FaceColor = 'flat';
end

%% Format the plot
xticks(1:3)
xticklabels(cities)
yticks(1:7)
yticklabels(days)
xlabel('Cities')
ylabel('Dates')
title('Cebu HUCs CoVID Cases (9/19/2021-9/25/2021)')

%% Legend (one entry per date, using empty patches as stand-ins)
hold on
p = gobjects(1, 7);
for j = 1:7
    p(j) = patch(NaN, NaN, cmap(j,:));
end
legend(p, days, 'Location', 'northeastoutside')
hold off

%% Save the plot
saveas(gcf, 'LE4_3a.png')
